# Discover all projects in work directory at depth 3
# Output format: "project_name|lang|status|path"
discover_projects() {
  local base_dir="$1"
  
  # Check if base directory exists
  if [[ ! -d "$base_dir" ]]; then
    return 0
  fi
  
  # Iterate through language directories
  for lang_dir in Python Typescript Solidity; do
    local lang_path="$base_dir/$lang_dir"
    if [[ ! -d "$lang_path" ]]; then
      continue
    fi
    
    # Map language directory to lowercase lang value
    local lang=""
    case "$lang_dir" in
      Python)     lang="python" ;;
      Typescript) lang="typescript" ;;
      Solidity)   lang="solidity" ;;
    esac
    
    # Iterate through status subdirectories
    for status_dir in active libs archive; do
      local status_path="$lang_path/$status_dir"
      if [[ ! -d "$status_path" ]]; then
        continue
      fi
      
      # Map status directory to registry status value
      local status=""
      case "$status_dir" in
        active)  status="active" ;;
        libs)    status="lib" ;;
        archive) status="archive" ;;
      esac
      
      # List project directories (immediate children only)
      # Use -d to list directories only, suppress errors for empty dirs
      while IFS= read -r project_dir; do
        if [[ -d "$project_dir" ]]; then
          local project_name
          project_name=$(basename "$project_dir")
          echo "${project_name}|${lang}|${status}|${project_dir}"
        fi
      done < <(find "$status_path" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true)
    done
  done
}

# Get all registered project paths from registry
get_registered_projects() {
  if [[ ! -f "$OVERLORD_REGISTRY" ]]; then
    return 0
  fi
  jq -r '.projects[].path' "$OVERLORD_REGISTRY" 2>/dev/null || true
}

# Find discovered projects not in registry
# Takes discovered projects on stdin, outputs unregistered projects
find_unregistered() {
  local discovered="$1"
  
  # Get registered paths into an associative array for fast lookup
  declare -A registered_paths
  while IFS= read -r path; do
    if [[ -n "$path" ]]; then
      registered_paths["$path"]=1
    fi
  done < <(get_registered_projects)
  
  # Filter discovered projects to exclude registered ones
  while IFS='|' read -r name lang status path; do
    if [[ -z "${registered_paths[$path]:-}" ]]; then
      echo "${name}|${lang}|${status}|${path}"
    fi
  done <<< "$discovered"
}

# Get status color
status_color() {
  case "$1" in
    active)  echo -e "${GREEN}" ;;
    lib)     echo -e "${CYAN}" ;;
    archive) echo -e "${DIM}" ;;
    *)       echo -e "${NC}" ;;
  esac
}

# Get language color
lang_color() {
  case "$1" in
    python)     echo -e "${BLUE}" ;;
    typescript) echo -e "${YELLOW}" ;;
    solidity)   echo -e "${RED}" ;;
    *)          echo -e "${NC}" ;;
  esac
}

# Format language short name
lang_short() {
  case "$1" in
    python)     echo "py" ;;
    typescript) echo "ts" ;;
    solidity)   echo "sol" ;;
    *)          echo "$1" ;;
  esac
}

