#!/usr/bin/env bash
# overlord-detect: Find unregistered projects in work directory

set -euo pipefail

# Setup environment (same pattern as overlord-list:7-11)
OVERLORD_REPO="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
OVERLORD_CONFIG="${OVERLORD_CONFIG:-$OVERLORD_REPO}"
OVERLORD_REGISTRY="$OVERLORD_CONFIG/registry.json"
OVERLORD_BIN="${OVERLORD_BIN:-$OVERLORD_REPO}"

# Resolve BASE_DIR with priority: ENV > Registry > Default
OVERLORD_BASE_DIR="${OVERLORD_BASE_DIR:-$(jq -r '.settings.base_dir // empty' "$OVERLORD_REGISTRY" 2>/dev/null || echo "$HOME/Work")}"

# Source common library
source "$OVERLORD_BIN/lib/common.sh"

# Define colors (use common.sh colors)
CYAN='\033[0;36m'
DIM='\033[2m'

usage() {
  cat <<'EOF'
Usage:
  overlord detect

Displays all projects found on disk in $OVERLORD_BASE_DIR that are not
registered in the Overlord registry.

Output shows: NAME | LANG | STATUS | PATH

Examples:
  overlord detect          # Show unregistered projects
EOF
}

# Discover all projects in work directory at depth 3
# Output format: "project_name|lang|status|path"
discover_projects() {
  local base_dir="$1"
  
  # Check if base directory exists
  if [[ ! -d "$base_dir" ]]; then
    return 0
  fi
  
  # Iterate through language directories
  for lang_dir in Python Typescript Solidity; do
    local lang_path="$base_dir/$lang_dir"
    if [[ ! -d "$lang_path" ]]; then
      continue
    fi
    
    # Map language directory to lowercase lang value
    local lang=""
    case "$lang_dir" in
      Python)     lang="python" ;;
      Typescript) lang="typescript" ;;
      Solidity)   lang="solidity" ;;
    esac
    
    # Iterate through status subdirectories
    for status_dir in active libs archive; do
      local status_path="$lang_path/$status_dir"
      if [[ ! -d "$status_path" ]]; then
        continue
      fi
      
      # Map status directory to registry status value
      local status=""
      case "$status_dir" in
        active)  status="active" ;;
        libs)    status="lib" ;;
        archive) status="archive" ;;
      esac
      
      # List project directories (immediate children only)
      # Use -d to list directories only, suppress errors for empty dirs
      while IFS= read -r project_dir; do
        if [[ -d "$project_dir" ]]; then
          local project_name
          project_name=$(basename "$project_dir")
          echo "${project_name}|${lang}|${status}|${project_dir}"
        fi
      done < <(find "$status_path" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true)
    done
  done
}

# Get all registered project paths from registry
get_registered_projects() {
  if [[ ! -f "$OVERLORD_REGISTRY" ]]; then
    return 0
  fi
  jq -r '.projects[].path' "$OVERLORD_REGISTRY" 2>/dev/null || true
}

# Find discovered projects not in registry
# Takes discovered projects on stdin, outputs unregistered projects
find_unregistered() {
  local discovered="$1"
  
  # Get registered paths into an associative array for fast lookup
  declare -A registered_paths
  while IFS= read -r path; do
    if [[ -n "$path" ]]; then
      registered_paths["$path"]=1
    fi
  done < <(get_registered_projects)
  
  # Filter discovered projects to exclude registered ones
  while IFS='|' read -r name lang status path; do
    if [[ -z "${registered_paths[$path]:-}" ]]; then
      echo "${name}|${lang}|${status}|${path}"
    fi
  done <<< "$discovered"
}

# Get status color
status_color() {
  case "$1" in
    active)  echo -e "${GREEN}" ;;
    lib)     echo -e "${CYAN}" ;;
    archive) echo -e "${DIM}" ;;
    *)       echo -e "${NC}" ;;
  esac
}

# Get language color
lang_color() {
  case "$1" in
    python)     echo -e "${BLUE}" ;;
    typescript) echo -e "${YELLOW}" ;;
    solidity)   echo -e "${RED}" ;;
    *)          echo -e "${NC}" ;;
  esac
}

# Format language short name
lang_short() {
  case "$1" in
    python)     echo "py" ;;
    typescript) echo "ts" ;;
    solidity)   echo "sol" ;;
    *)          echo "$1" ;;
  esac
}

# Format unregistered projects as table
format_output() {
  local projects="$1"  # newline-separated: "name|lang|status|path"
  
  if [[ -z "$projects" ]]; then
    echo -e "${DIM}No unregistered projects found.${NC}"
    return
  fi

  # Header
  printf "${DIM}%-40s %-6s %-8s %-40s${NC}\n" "NAME" "LANG" "STATUS" "PATH"
  printf "${DIM}%-40s %-6s %-8s %-40s${NC}\n" "----" "----" "------" "----"

  # Sort by status (active=1, lib=2, archive=3)
  local sorted_projects
  sorted_projects=$(while IFS='|' read -r name lang status path; do
    local sort_order=4
    case "$status" in
      active)  sort_order=1 ;;
      lib)     sort_order=2 ;;
      archive) sort_order=3 ;;
    esac
    echo "${sort_order}|${name}|${lang}|${status}|${path}"
  done <<< "$projects" | sort -t'|' -k1,1n | cut -d'|' -f2-)
  
  # Projects (process line by line)
  while IFS='|' read -r name lang status path; do
    local lc sc
    lc=$(lang_color "$lang")
    sc=$(status_color "$status")
    local lang_s
    lang_s=$(lang_short "$lang")
    
    # Truncate path for display
    local display_path="$path"
    if [[ ${#display_path} -gt 40 ]]; then
      display_path="...${display_path: -37}"
    fi

    printf "${sc}%-40s ${lc}%-6s ${sc}%-8s ${NC}%-40s${NC}\n" \
      "$name" "$lang_s" "$status" "$display_path"
  done <<< "$sorted_projects"
}

main() {
  # Parse arguments
  if [[ $# -gt 0 ]]; then
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      *)
        log_error "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  fi
  
  # Verify base_dir exists
  if [[ ! -d "$OVERLORD_BASE_DIR" ]]; then
    log_error "Base directory does not exist: $OVERLORD_BASE_DIR"
    log_info "Set OVERLORD_BASE_DIR or update registry settings"
    exit 1
  fi
  
  # Discover projects, compare against registry, display
  local discovered
  discovered=$(discover_projects "$OVERLORD_BASE_DIR")
  
  if [[ -z "$discovered" ]]; then
    echo -e "${DIM}No projects found in work directory.${NC}"
    exit 0
  fi
  
  local unregistered
  unregistered=$(find_unregistered "$discovered")
  
  format_output "$unregistered"
}

main "$@"
