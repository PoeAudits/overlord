#!/usr/bin/env bash
# overlord-open: Open project workspace with tmux
# Uses fzf for fuzzy search when no exact match found
# Only opens active and lib projects (archived projects must be moved first)

set -euo pipefail

OVERLORD_REPO="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
OVERLORD_CONFIG="${OVERLORD_CONFIG:-$OVERLORD_REPO}"
OVERLORD_REGISTRY="$OVERLORD_CONFIG/registry.json"
OVERLORD_BIN="${OVERLORD_BIN:-$OVERLORD_REPO}"

# Source common library
source "$OVERLORD_BIN/lib/common.sh"

usage() {
  cat <<'EOF'
Usage:
  overlord open [name] [--fuzzy|-f] [--force]

Arguments:
  name      Project name or alias (optional)

Options:
  --fuzzy, -f    Force fuzzy search (skip exact match)
  --force        Open archived projects without moving to active first

Behavior:
  - No argument: Launch fzf picker with active/lib projects
  - Exact match: Open project immediately
  - No exact match: Launch fzf pre-filtered with query
  - With --fuzzy: Skip exact match and launch fzf immediately
  - With --force: Allow opening archived projects (normally requires moving to active first)

Examples:
  overlord open              # Interactive picker
  overlord open myproject    # Open exact match
  overlord open mypr         # Fuzzy search if no exact match
  overlord open mypr --fuzzy # Force fuzzy search
  overlord open myarchived --force  # Open archived project without moving
EOF
}

# Get all openable projects (active and lib only)
get_openable_projects() {
  jq -r '
    .projects | to_entries[] | 
    select(.value.status == "active" or .value.status == "lib") |
    "\(.key)\t\(.value.lang)\t\(.value.status)\t\(.value.path)"
  ' "$OVERLORD_REGISTRY" 2>/dev/null || true
}

# Get all openable projects including archived (when --force is used)
get_openable_projects_with_force() {
  jq -r '
    .projects | to_entries[] | 
    select(.value.status == "active" or .value.status == "lib" or .value.status == "archive") |
    "\(.key)\t\(.value.lang)\t\(.value.status)\t\(.value.path)"
  ' "$OVERLORD_REGISTRY" 2>/dev/null || true
}

# Format project for fzf display
format_for_fzf() {
  local projects="$1"
  while IFS=$'\t' read -r name lang status path; do
    [[ -z "$name" ]] && continue
    local lang_short
    case "$lang" in
      python)     lang_short="py" ;;
      typescript) lang_short="ts" ;;
      solidity)   lang_short="sol" ;;
      *)          lang_short="$lang" ;;
    esac
    printf "%-20s [%s] %-7s %s\n" "$name" "$lang_short" "$status" "$path"
  done <<< "$projects"
}

# Run fzf picker
run_fzf_picker() {
  local query="${1:-}"
  local include_archived="${2:-false}"
  local projects
  
  if [[ "$include_archived" == true ]]; then
    projects=$(get_openable_projects_with_force)
  else
    projects=$(get_openable_projects)
  fi
  
  if [[ -z "$projects" ]]; then
    if [[ "$include_archived" == true ]]; then
      log_error "No projects found"
    else
      log_error "No active or lib projects found"
      log_info "Create a project with 'overlord new' or activate archived projects with 'overlord mv'"
    fi
    exit 1
  fi
  
  local formatted
  formatted=$(format_for_fzf "$projects")
  
   local header="Select project (active/lib only)"
   if [[ "$include_archived" == true ]]; then
     header="Select project (active/lib/archive)"
   fi
   
   local fzf_args=(
     --height=40%
     --reverse
     --header="$header"
     --prompt="project> "
   )
  
  if [[ -n "$query" ]]; then
    fzf_args+=(--query="$query")
  fi
  
  local selection
  selection=$(echo "$formatted" | fzf "${fzf_args[@]}" 2>/dev/null || true)
  
  if [[ -z "$selection" ]]; then
    exit 0
  fi
  
  # Extract project name (first field)
  echo "$selection" | awk '{print $1}'
}

# Create or attach to tmux session
create_or_attach_session() {
  local session="$1"
  local project_dir="$2"
  shift 2
  local args=("$@")

  # Attach if session exists
  if tmux has-session -t "$session" 2>/dev/null; then
    log_info "Attaching to existing session: $session"
    if [[ -n "${TMUX-}" ]]; then
      exec tmux switch-client -t "$session"
    else
      exec tmux attach -t "$session"
    fi
  fi

  log_info "Creating new session: $session"
  log_info "Directory: $project_dir"

  # Create session
  tmux new-session -d -s "$session" -c "$project_dir" -n base

  # Check for local tmux config
  local local_rc="$project_dir/.tmux.local"
  local mode="override"

  if [[ -f "$local_rc" ]]; then
    local maybe_mode
    maybe_mode=$(grep -E '^[[:space:]]*MODE=' "$local_rc" 2>/dev/null | head -n1 || true)
    if [[ -n "$maybe_mode" ]]; then
      mode=$(echo "$maybe_mode" | sed -E 's/^[[:space:]]*MODE=//; s/[[:space:]]*$//')
    fi
  fi

  if [[ -f "$local_rc" && "$mode" == "override" ]]; then
    # Full override mode
    TMUX_SESSION="$session" TMUX_PROJECT_DIR="$project_dir" \
      bash "$local_rc" "${args[@]}"
  else
    # Default layout
    tmux rename-window -t "${session}:base" "editor"
    tmux send-keys -t "${session}:editor" "nvim" C-m

    tmux new-window -t "$session:" -n shell -c "$project_dir"
    tmux new-window -t "$session:" -n git -c "$project_dir"
    tmux send-keys -t "${session}:git" "git status" C-m

    # Run local config in merge mode if present
    if [[ -f "$local_rc" && "$mode" == "merge" ]]; then
      TMUX_SESSION="$session" TMUX_PROJECT_DIR="$project_dir" \
        bash "$local_rc" "${args[@]}"
    fi
  fi

  # Focus editor window
  tmux select-window -t "${session}:editor"

  # Attach
  if [[ -n "${TMUX-}" ]]; then
    exec tmux switch-client -t "$session"
  else
    exec tmux attach -t "$session"
  fi
}

main() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
  fi

  local query="${1:-}"
  shift || true
  
  # Check for flags
  local force_fuzzy=false
  local force_open=false
  
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fuzzy|-f) force_fuzzy=true ;;
      --force) force_open=true ;;
      *) log_error "Unknown option: $1"; exit 1 ;;
    esac
    shift || true
  done

  local project_name=""
  local project_info=""

  if [[ -n "$query" ]]; then
    # If fuzzy flag is set, skip exact match and go straight to fzf
    if [[ "$force_fuzzy" == true ]]; then
      project_name=$(run_fzf_picker "$query" "$force_open")
      if [[ -n "$project_name" ]]; then
        project_info=$(find_project_exact "$project_name")
      fi
    else
      # Try exact match first
      if project_info=$(find_project_exact "$query"); then
        project_name=$(echo "$project_info" | cut -f1)
      else
        # No exact match, use fzf with query
        project_name=$(run_fzf_picker "$query" "$force_open")
        if [[ -n "$project_name" ]]; then
          project_info=$(find_project_exact "$project_name")
        fi
      fi
    fi
  else
    # No query, launch fzf picker
    project_name=$(run_fzf_picker "" "$force_open")
    if [[ -n "$project_name" ]]; then
      project_info=$(find_project_exact "$project_name")
    fi
  fi

  if [[ -z "$project_name" || -z "$project_info" ]]; then
    exit 0
  fi

  # Parse project info
  local name lang status path
  IFS=$'\t' read -r name lang status path <<< "$project_info"

  # Check if archived (unless --force is used)
  if [[ "$status" == "archive" && "$force_open" == false ]]; then
    log_error "Cannot open archived project: $name"
    log_info "Move to active first: overlord mv $name active"
    log_info "Or use --force to open without moving: overlord open $name --force"
    exit 1
  fi

  # Check path exists
  if [[ ! -d "$path" ]]; then
    log_error "Project directory does not exist: $path"
    log_warning "Registry may be out of sync"
    exit 1
  fi

  # Open session
  create_or_attach_session "$name" "$path" "$@"
}

main "$@"
