#!/usr/bin/env bash
# overlord-config: Open registry.json in editor

set -euo pipefail

OVERLORD_REPO="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
OVERLORD_CONFIG="${OVERLORD_CONFIG:-$OVERLORD_REPO}"
OVERLORD_REGISTRY="$OVERLORD_CONFIG/registry.json"
OVERLORD_BIN="${OVERLORD_BIN:-$OVERLORD_REPO}"
EDITOR="${EDITOR:-nvim}"

# Source common library
source "$OVERLORD_BIN/lib/common.sh"

usage() {
  cat <<'EOF'
Usage:
  overlord config

Opens the registry.json file in your editor ($EDITOR or nvim).

Use this to:
  - Add or modify project aliases
  - Manually edit project metadata
  - Fix registry issues
EOF
}

main() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
  fi

  if [[ ! -f "$OVERLORD_REGISTRY" ]]; then
    log_info "Creating registry at $OVERLORD_REGISTRY"
    mkdir -p "$OVERLORD_CONFIG"
    echo '{"projects":{}}' > "$OVERLORD_REGISTRY"
  fi

  exec "$EDITOR" "$OVERLORD_REGISTRY"
}

main "$@"
