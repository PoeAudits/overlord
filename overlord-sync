#!/usr/bin/env bash
# overlord-sync: Propagate Makefile templates to projects
# Combines base.mk + language-specific template into each project's Makefile

set -euo pipefail

OVERLORD_CONFIG="${OVERLORD_CONFIG:-$HOME/.config/overlord}"
OVERLORD_REGISTRY="$OVERLORD_CONFIG/registry.json"
MAKEFILE_DIR="$OVERLORD_CONFIG/makefiles"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
DIM='\033[2m'
NC='\033[0m'

usage() {
  cat <<'EOF'
Usage:
  overlord sync [options]

Propagates Makefile templates to all registered projects.
Combines base.mk with language-specific template (python.mk, typescript.mk, solidity.mk).

Options:
  --py, --python       Sync only Python projects
  --ts, --typescript   Sync only TypeScript projects
  --sol, --solidity    Sync only Solidity projects
  --dry-run            Show what would be done without making changes
  --help               Show this help

Examples:
  overlord sync                  # Sync all projects
  overlord sync --py             # Sync only Python projects
  overlord sync --dry-run        # Preview changes
EOF
}

log_info() { echo -e "${BLUE}>${NC} $*"; }
log_success() { echo -e "${GREEN}✓${NC} $*"; }
log_error() { echo -e "${RED}✗${NC} $*" >&2; }
log_warning() { echo -e "${YELLOW}!${NC} $*"; }
log_dim() { echo -e "${DIM}  $*${NC}"; }

# Parse arguments
FILTER_LANG=""
DRY_RUN=false

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --py|--python)
        FILTER_LANG="python"
        ;;
      --ts|--typescript)
        FILTER_LANG="typescript"
        ;;
      --sol|--solidity)
        FILTER_LANG="solidity"
        ;;
      --dry-run)
        DRY_RUN=true
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        log_error "Unknown option: $1"
        exit 1
        ;;
    esac
    shift
  done
}

# Get language-specific makefile name
get_lang_makefile() {
  case "$1" in
    python)     echo "python.mk" ;;
    typescript) echo "typescript.mk" ;;
    solidity)   echo "solidity.mk" ;;
  esac
}

# Generate combined Makefile content
generate_makefile() {
  local lang="$1"
  local lang_mk
  lang_mk=$(get_lang_makefile "$lang")
  
  local base_file="$MAKEFILE_DIR/base.mk"
  local lang_file="$MAKEFILE_DIR/$lang_mk"
  
  if [[ ! -f "$base_file" ]]; then
    log_error "Base makefile not found: $base_file"
    return 1
  fi
  
  if [[ ! -f "$lang_file" ]]; then
    log_error "Language makefile not found: $lang_file"
    return 1
  fi
  
  # Combine base + language-specific
  cat "$base_file"
  echo ""
  cat "$lang_file"
}

# Sync a single project
sync_project() {
  local name="$1"
  local lang="$2"
  local path="$3"
  
  if [[ ! -d "$path" ]]; then
    log_warning "Directory not found: $path (skipping $name)"
    return 0
  fi
  
  local makefile_path="$path/Makefile"
  
  if [[ "$DRY_RUN" == true ]]; then
    log_info "[dry-run] Would sync: $name ($lang)"
    log_dim "  -> $makefile_path"
    return 0
  fi
  
  # Generate and write Makefile
  if generate_makefile "$lang" > "$makefile_path"; then
    log_success "Synced: $name ($lang)"
  else
    log_error "Failed to sync: $name"
    return 1
  fi
}

# Main sync logic
sync_projects() {
  if [[ ! -f "$OVERLORD_REGISTRY" ]]; then
    log_error "Registry not found: $OVERLORD_REGISTRY"
    exit 1
  fi
  
  # Build jq filter
  local jq_filter='.projects | to_entries[]'
  if [[ -n "$FILTER_LANG" ]]; then
    jq_filter="$jq_filter | select(.value.lang == \"$FILTER_LANG\")"
  fi
  
  # Get projects
  local projects
  projects=$(jq -r "$jq_filter | [.key, .value.lang, .value.path] | @tsv" "$OVERLORD_REGISTRY" 2>/dev/null || true)
  
  if [[ -z "$projects" ]]; then
    log_warning "No projects found to sync"
    exit 0
  fi
  
  local synced_count=0
  local failed_count=0
  local skipped_count=0
  
  if [[ "$DRY_RUN" == true ]]; then
    log_info "Dry run mode - no changes will be made"
    echo ""
  fi
  
  while IFS=$'\t' read -r name lang path; do
    if sync_project "$name" "$lang" "$path"; then
      ((synced_count++))
    else
      ((failed_count++))
    fi
  done <<< "$projects"
  
  echo ""
  if [[ "$DRY_RUN" == true ]]; then
    log_info "Would sync $synced_count project(s)"
  else
    log_success "Synced $synced_count project(s)"
    if [[ $failed_count -gt 0 ]]; then
      log_warning "Failed: $failed_count"
    fi
  fi
}

main() {
  parse_args "$@"
  sync_projects
}

main "$@"
