#!/usr/bin/env bash
# overlord-new: Create a new project with language-specific initialization
# Supports: Python (uv), TypeScript (pnpm), Solidity (forge)

set -euo pipefail

OVERLORD_CONFIG="${OVERLORD_CONFIG:-$HOME/.config/overlord}"
OVERLORD_REGISTRY="$OVERLORD_CONFIG/registry.json"
WORK_DIR="$HOME/Work"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
  cat <<'EOF'
Usage:
  overlord new <name> --py|--ts|--sol [options]

Language flags (required, one of):
  --py, --python       Create Python project (uses uv)
  --ts, --typescript   Create TypeScript project (uses pnpm)
  --sol, --solidity    Create Solidity project (uses forge)

Options:
  --lib                Create in libs/ instead of active/
  --no-git             Skip git initialization
  --no-open, -s        Don't open workspace after creation
  --force              Overwrite existing project directory
  --help               Show this help

Examples:
  overlord new myapp --py
  overlord new mylib --ts --lib
  overlord new mycontract --sol --no-open
EOF
}

log_info() { echo -e "${BLUE}>${NC} $*"; }
log_success() { echo -e "${GREEN}✓${NC} $*"; }
log_error() { echo -e "${RED}✗${NC} $*" >&2; }
log_warning() { echo -e "${YELLOW}!${NC} $*"; }

# Parse arguments
LANGUAGE=""
PROJECT_NAME=""
STATUS="active"
INIT_GIT=true
OPEN_WS=true
FORCE=false

parse_args() {
  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --py|--python)
        LANGUAGE="python"
        ;;
      --ts|--typescript)
        LANGUAGE="typescript"
        ;;
      --sol|--solidity)
        LANGUAGE="solidity"
        ;;
      --lib)
        STATUS="lib"
        ;;
      --no-git)
        INIT_GIT=false
        ;;
      --no-open|-s)
        OPEN_WS=false
        ;;
      --force)
        FORCE=true
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      -*)
        log_error "Unknown option: $1"
        exit 1
        ;;
      *)
        if [[ -z "$PROJECT_NAME" ]]; then
          PROJECT_NAME="$1"
        else
          log_error "Unexpected argument: $1"
          exit 1
        fi
        ;;
    esac
    shift
  done

  if [[ -z "$PROJECT_NAME" ]]; then
    log_error "Project name is required"
    usage >&2
    exit 1
  fi

  if [[ -z "$LANGUAGE" ]]; then
    log_error "Language flag is required (--py, --ts, or --sol)"
    usage >&2
    exit 1
  fi
}

validate_project_name() {
  local name="$1"
  if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    log_error "Project name can only contain alphanumeric characters, underscores, and hyphens"
    exit 1
  fi
}

get_lang_dir() {
  case "$1" in
    python)     echo "Python" ;;
    typescript) echo "Typescript" ;;
    solidity)   echo "Solidity" ;;
  esac
}

get_status_dir() {
  case "$1" in
    active)  echo "active" ;;
    lib)     echo "libs" ;;
    archive) echo "archive" ;;
  esac
}

# Initialize Python project
init_python() {
  local dir="$1"
  log_info "Initializing Python project with uv..."
  
  if ! command -v uv &>/dev/null; then
    log_error "uv is not installed"
    exit 1
  fi

  cd "$dir"
  uv init
  log_success "Python project initialized"
}

# Initialize TypeScript project
init_typescript() {
  local dir="$1"
  log_info "Initializing TypeScript project with pnpm..."
  
  if ! command -v pnpm &>/dev/null; then
    log_error "pnpm is not installed"
    exit 1
  fi

  cd "$dir"
  pnpm init
  pnpm add -D typescript @types/node

  if [[ ! -f "tsconfig.json" ]]; then
    cat > tsconfig.json <<'TSCONFIG'
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
TSCONFIG
  fi
  
  mkdir -p src
  log_success "TypeScript project initialized"
}

# Initialize Solidity project
init_solidity() {
  local dir="$1"
  log_info "Initializing Solidity project with forge..."
  
  if ! command -v forge &>/dev/null; then
    log_error "forge is not installed"
    exit 1
  fi

  cd "$dir"
  forge init --no-commit
  log_success "Solidity project initialized"
}

# Initialize git repository
init_git() {
  local dir="$1"
  log_info "Initializing git repository..."
  
  cd "$dir"
  if [[ ! -d ".git" ]]; then
    git init
    git add .
    git commit -m "Initial commit" 2>/dev/null || log_warning "No changes to commit"
    log_success "Git repository initialized"
  else
    log_warning "Git repository already exists"
  fi
}

# Copy tmux template
copy_tmux_template() {
  local dir="$1"
  local lang="$2"
  local template="$OVERLORD_CONFIG/tmux/${lang}.tmux"
  
  if [[ -f "$template" ]]; then
    cp "$template" "$dir/.tmux.local"
    chmod +x "$dir/.tmux.local"
    log_success "Copied ${lang} tmux template"
  else
    log_warning "No tmux template found for ${lang}"
  fi
}

# Get language-specific makefile name
get_lang_makefile() {
  case "$1" in
    python)     echo "python.mk" ;;
    typescript) echo "typescript.mk" ;;
    solidity)   echo "solidity.mk" ;;
  esac
}

# Generate Makefile from templates
generate_makefile() {
  local dir="$1"
  local lang="$2"
  local makefile_dir="$OVERLORD_CONFIG/makefiles"
  local lang_mk
  lang_mk=$(get_lang_makefile "$lang")
  
  local base_file="$makefile_dir/base.mk"
  local lang_file="$makefile_dir/$lang_mk"
  
  if [[ ! -f "$base_file" ]]; then
    log_warning "Base makefile template not found"
    return 0
  fi
  
  if [[ ! -f "$lang_file" ]]; then
    log_warning "Language makefile template not found for ${lang}"
    return 0
  fi
  
  # Combine base + language-specific
  {
    cat "$base_file"
    echo ""
    cat "$lang_file"
  } > "$dir/Makefile"
  
  log_success "Generated Makefile"
}

# Copy opencode.jsonc template
copy_opencode_template() {
  local dir="$1"
  local lang="$2"
  local template="$OVERLORD_CONFIG/templates/opencode-${lang}.jsonc"
  
  if [[ -f "$template" ]]; then
    cp "$template" "$dir/opencode.jsonc"
    log_success "Created opencode.jsonc"
  else
    log_warning "No opencode template found for ${lang}"
  fi
}

# Create thoughts directory structure
create_thoughts_dirs() {
  local dir="$1"
  local thoughts_dir="$dir/thoughts"
  
  mkdir -p "$thoughts_dir/tickets"
  mkdir -p "$thoughts_dir/plans"
  mkdir -p "$thoughts_dir/logs"
  mkdir -p "$thoughts_dir/research"
  mkdir -p "$thoughts_dir/handoffs"
  
  log_success "Created thoughts/ directory structure"
}

# Register project in registry
register_project() {
  local name="$1"
  local lang="$2"
  local status="$3"
  local path="$4"
  local date
  date=$(date +%Y-%m-%d)

  local tmp_file
  tmp_file=$(mktemp)
  
  jq --arg name "$name" \
     --arg lang "$lang" \
     --arg status "$status" \
     --arg path "$path" \
     --arg date "$date" \
     '.projects[$name] = {
       "lang": $lang,
       "status": $status,
       "path": $path,
       "created": $date,
       "aliases": []
     }' "$OVERLORD_REGISTRY" > "$tmp_file"
  
  mv "$tmp_file" "$OVERLORD_REGISTRY"
  log_success "Registered project in registry"
}

main() {
  parse_args "$@"
  validate_project_name "$PROJECT_NAME"

  local lang_dir
  lang_dir=$(get_lang_dir "$LANGUAGE")
  local status_dir
  status_dir=$(get_status_dir "$STATUS")
  
  local project_dir="$WORK_DIR/$lang_dir/$status_dir/$PROJECT_NAME"

  log_info "Creating ${LANGUAGE} project: ${PROJECT_NAME}"
  log_info "Location: $project_dir"
  log_info "Status: $STATUS"
  echo ""

  # Check if project exists
  if [[ -d "$project_dir" ]]; then
    if [[ "$FORCE" == false ]]; then
      log_error "Project directory already exists: $project_dir"
      log_error "Use --force to overwrite"
      exit 1
    else
      log_warning "Removing existing directory..."
      rm -rf "$project_dir"
    fi
  fi

  # Create directory structure
  mkdir -p "$project_dir"

  # Language-specific initialization
  case "$LANGUAGE" in
    python)     init_python "$project_dir" ;;
    typescript) init_typescript "$project_dir" ;;
    solidity)   init_solidity "$project_dir" ;;
  esac
  echo ""

  # Git initialization
  if [[ "$INIT_GIT" == true ]]; then
    init_git "$project_dir"
    echo ""
  fi

  # Copy tmux template
  copy_tmux_template "$project_dir" "$LANGUAGE"

  # Generate Makefile
  generate_makefile "$project_dir" "$LANGUAGE"

  # Create opencode.jsonc
  copy_opencode_template "$project_dir" "$LANGUAGE"

  # Create thoughts directory structure
  create_thoughts_dirs "$project_dir"

  # Register in registry
  register_project "$PROJECT_NAME" "$LANGUAGE" "$STATUS" "$project_dir"

  echo ""
  log_success "Project created successfully!"
  echo ""

  # Open workspace
  if [[ "$OPEN_WS" == true ]]; then
    log_info "Opening workspace..."
    exec "$HOME/bin/overlord-open" "$PROJECT_NAME"
  else
    log_info "Run 'overlord open ${PROJECT_NAME}' to open workspace"
  fi
}

main "$@"
