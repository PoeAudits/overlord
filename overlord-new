#!/usr/bin/env bash
# overlord-new: Create a new project with language-specific initialization
# Supports: Python (uv), TypeScript (pnpm), Solidity (forge)

set -euo pipefail

OVERLORD_REPO="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
OVERLORD_CONFIG="${OVERLORD_CONFIG:-$OVERLORD_REPO}"
OVERLORD_REGISTRY="$OVERLORD_CONFIG/registry.json"
OVERLORD_BIN="${OVERLORD_BIN:-$OVERLORD_REPO}"

# Source common library
source "$OVERLORD_BIN/lib/common.sh"

usage() {
  cat <<'EOF'
Usage:
  overlord new <name> --py|--ts|--sol [options]

Language flags (required, one of):
  --py, --python       Create Python project (uses uv)
  --ts, --typescript   Create TypeScript project (uses pnpm)
  --sol, --solidity    Create Solidity project (uses forge)

Options:
  --lib                Create in libs/ instead of active/
  --alias <name>       Add alias (can be used multiple times)
  --no-git             Skip git initialization
  --no-open, -s        Don't open workspace after creation
  --force              Overwrite existing project directory
  --help               Show this help

Examples:
  overlord new myapp --py
  overlord new mylib --ts --lib
  overlord new mycontract --sol --no-open
  overlord new myproject --py --alias proj --alias mp
EOF
}

# Parse arguments
LANGUAGE=""
PROJECT_NAME=""
STATUS="active"
INIT_GIT=true
OPEN_WS=true
FORCE=false
ALIASES=()

parse_args() {
  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --py|--python)
        LANGUAGE="python"
        ;;
      --ts|--typescript)
        LANGUAGE="typescript"
        ;;
      --sol|--solidity)
        LANGUAGE="solidity"
        ;;
      --lib)
        STATUS="lib"
        ;;
      --alias)
        if [[ $# -lt 2 ]]; then
          log_error "--alias requires an argument"
          exit 1
        fi
        shift
        ALIASES+=("$1")
        ;;
      --no-git)
        INIT_GIT=false
        ;;
      --no-open|-s)
        OPEN_WS=false
        ;;
      --force)
        FORCE=true
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      -*)
        log_error "Unknown option: $1"
        exit 1
        ;;
      *)
        if [[ -z "$PROJECT_NAME" ]]; then
          PROJECT_NAME="$1"
        else
          log_error "Unexpected argument: $1"
          exit 1
        fi
        ;;
    esac
    shift
  done

  if [[ -z "$PROJECT_NAME" ]]; then
    log_error "Project name is required"
    usage >&2
    exit 1
  fi

  if [[ -z "$LANGUAGE" ]]; then
    log_error "Language flag is required (--py, --ts, or --sol)"
    usage >&2
    exit 1
  fi
}

validate_project_name() {
  local name="$1"
  if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    log_error "Project name can only contain alphanumeric characters, underscores, and hyphens"
    exit 1
  fi
}

# Initialize Python project
init_python() {
  local dir="$1"
  log_info "Initializing Python project with uv..."
  
  if ! command -v uv &>/dev/null; then
    log_error "uv is not installed"
    exit 1
  fi

  (
    cd "$dir"
    uv init
  )
  log_success "Python project initialized"
}

# Initialize TypeScript project
init_typescript() {
  local dir="$1"
  log_info "Initializing TypeScript project with pnpm..."
  
  if ! command -v pnpm &>/dev/null; then
    log_error "pnpm is not installed"
    exit 1
  fi

  (
    cd "$dir"
    pnpm init
    pnpm add -D typescript @types/node

    if [[ ! -f "tsconfig.json" ]]; then
      cat > tsconfig.json <<'TSCONFIG'
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
TSCONFIG
    fi
    
    mkdir -p src
  )
  log_success "TypeScript project initialized"
}

# Initialize Solidity project
init_solidity() {
  local dir="$1"
  log_info "Initializing Solidity project with forge..."
  
  if ! command -v forge &>/dev/null; then
    log_error "forge is not installed"
    exit 1
  fi

  (
    cd "$dir"
    forge init
  )
  log_success "Solidity project initialized"
}

# Initialize git repository
init_git() {
  local dir="$1"
  log_info "Initializing git repository..."
  
  (
    cd "$dir"
    if [[ ! -d ".git" ]]; then
      git init
      git add .
      git commit -m "Initial commit" 2>/dev/null || log_warning "No changes to commit"
      log_success "Git repository initialized"
    else
      log_warning "Git repository already exists"
    fi
  )
}

# Register project in registry with aliases
register_project() {
  local name="$1"
  local lang="$2"
  local status="$3"
  local path="$4"
  shift 4
  local aliases=("$@")
  local date
  date=$(date +%Y-%m-%d)

  local tmp_file
  tmp_file=$(mktemp)
  
  # Convert bash array to JSON array
  local aliases_json
  if [[ ${#aliases[@]} -eq 0 ]]; then
    aliases_json="[]"
  else
    aliases_json=$(printf '%s\n' "${aliases[@]}" | jq -R . | jq -s .)
  fi
  
  jq --arg name "$name" \
     --arg lang "$lang" \
     --arg status "$status" \
     --arg path "$path" \
     --arg date "$date" \
     --argjson aliases "$aliases_json" \
     '.projects[$name] = {
       "lang": $lang,
       "status": $status,
       "path": $path,
       "created": $date,
       "aliases": $aliases
     }' "$OVERLORD_REGISTRY" > "$tmp_file"
  
  mv "$tmp_file" "$OVERLORD_REGISTRY"
  log_success "Registered project in registry"
}

main() {
  parse_args "$@"
  validate_project_name "$PROJECT_NAME"

  local lang_dir
  lang_dir=$(get_lang_dir "$LANGUAGE")
  local status_dir
  status_dir=$(get_status_dir "$STATUS")
  
  local project_dir="$OVERLORD_BASE_DIR/$lang_dir/$status_dir/$PROJECT_NAME"

  log_info "Creating ${LANGUAGE} project: ${PROJECT_NAME}"
  log_info "Location: $project_dir"
  log_info "Status: $STATUS"
  echo ""

  # Check if project exists
  if [[ -d "$project_dir" ]]; then
    if [[ "$FORCE" == false ]]; then
      log_error "Project directory already exists: $project_dir"
      log_error "Use --force to overwrite"
      exit 1
    else
      log_warning "Removing existing directory..."
      rm -rf "$project_dir"
    fi
  fi

  # Create directory structure
  mkdir -p "$project_dir"

  # Language-specific initialization
  case "$LANGUAGE" in
    python)     init_python "$project_dir" ;;
    typescript) init_typescript "$project_dir" ;;
    solidity)   init_solidity "$project_dir" ;;
  esac
  echo ""

  # Git initialization
  if [[ "$INIT_GIT" == true ]]; then
    init_git "$project_dir"
    echo ""
  fi

  # Copy templates and initialize
  copy_tmux_template "$project_dir" "$LANGUAGE"
  generate_makefile "$project_dir" "$LANGUAGE"
  copy_opencode_template "$project_dir" "$LANGUAGE"
  create_thoughts_dirs "$project_dir"

   # Register in registry with aliases
   register_project "$PROJECT_NAME" "$LANGUAGE" "$STATUS" "$project_dir" "${ALIASES[@]}"

  echo ""
  log_success "Project created successfully!"
  echo ""

  # Open workspace
  if [[ "$OPEN_WS" == true ]]; then
    log_info "Opening workspace..."
    exec "$OVERLORD_BIN/overlord-open" "$PROJECT_NAME"
  else
    log_info "Run 'overlord open ${PROJECT_NAME}' to open workspace"
  fi
}

main "$@"
