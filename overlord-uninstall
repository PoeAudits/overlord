#!/usr/bin/env bash
# overlord-uninstall: Remove overlord from system
# Removes symlink and repository, preserves all projects

set -euo pipefail

# Auto-detect repository (same pattern as other scripts)
OVERLORD_REPO="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
OVERLORD_CONFIG="${OVERLORD_CONFIG:-$OVERLORD_REPO}"
OVERLORD_REGISTRY="$OVERLORD_CONFIG/registry.json"
OVERLORD_BIN="${OVERLORD_BIN:-$OVERLORD_REPO}"

# Source common library for logging functions
source "$OVERLORD_BIN/lib/common.sh"

# Additional formatting
BOLD='\033[1m'
CYAN='\033[0;36m'
DIM='\033[2m'

# Installation target for symlink
INSTALL_TARGET="/usr/local/bin/overlord"

usage() {
  cat <<'EOF'
Usage:
  overlord uninstall [options]

Description:
  Removes overlord from the system by deleting the symlink and repository.
  All project directories and their configurations remain completely untouched.

Options:
  --dry-run     Show what would be deleted without deleting anything
  --force, -f   Skip confirmation prompt
  --help, -h    Show this help

What Gets Deleted:
  - Symlink: /usr/local/bin/overlord
  - Repository: ~/bin/overlord/ (all scripts, templates, registry)

What Stays (Preserved):
  - All project directories in ~/Work/
  - Project .tmux.local files
  - Project Makefile files
  - Project .opencode/ directories
  - Project thoughts/ directories

Examples:
  overlord uninstall              # Show prompt before uninstalling
  overlord uninstall --dry-run    # Preview what would be deleted
  overlord uninstall --force      # Skip confirmation prompt

Notes:
  - Registry is backed up to /tmp/ before deletion
  - Projects lose registry entries but files remain intact
  - Use 'overlord add' after reinstalling to re-register projects
EOF
}

# Detect if sudo is needed for /usr/local/bin
check_sudo_requirement() {
  if [[ ! -w "/usr/local/bin" ]]; then
    return 0  # Needs sudo
  else
    return 1  # No sudo needed
  fi
}

# Find the symlink target
resolve_symlink() {
  if [[ -L "$INSTALL_TARGET" ]]; then
    readlink "$INSTALL_TARGET"
  else
    echo ""
  fi
}

# Generate list of files to be deleted
generate_removal_list() {
  local symlink_target
  symlink_target=$(resolve_symlink)
  
  echo ""
  echo -e "${BOLD}Files and directories to be deleted:${NC}"
  echo ""
  
  # Symlink
  if [[ -L "$INSTALL_TARGET" ]]; then
    echo -e "  ${RED}✗${NC} Symlink: $INSTALL_TARGET"
    if [[ -n "$symlink_target" ]]; then
      echo -e "    ${DIM}→ $symlink_target${NC}"
    fi
  elif [[ -e "$INSTALL_TARGET" ]]; then
    echo -e "  ${YELLOW}!${NC} File: $INSTALL_TARGET (not a symlink)"
  else
    echo -e "  ${DIM}○ Symlink: $INSTALL_TARGET (not found)${NC}"
  fi
  
  # Repository directory
  if [[ -d "$OVERLORD_REPO" ]]; then
    echo -e "  ${RED}✗${NC} Repository: $OVERLORD_REPO"
    
    # Count items in repository
    local script_count template_count makefile_count tmux_count
    script_count=$(find "$OVERLORD_REPO" -maxdepth 1 -type f -name "overlord*" 2>/dev/null | wc -l)
    template_count=$(find "$OVERLORD_REPO/templates" -type f 2>/dev/null | wc -l)
    makefile_count=$(find "$OVERLORD_REPO/makefiles" -type f 2>/dev/null | wc -l)
    tmux_count=$(find "$OVERLORD_REPO/tmux" -type f 2>/dev/null | wc -l)
    
    echo -e "    ${DIM}Scripts: $script_count${NC}"
    echo -e "    ${DIM}Templates: $template_count${NC}"
    echo -e "    ${DIM}Makefiles: $makefile_count${NC}"
    echo -e "    ${DIM}Tmux configs: $tmux_count${NC}"
  else
    echo -e "  ${DIM}○ Repository: $OVERLORD_REPO (not found)${NC}"
  fi
  
  # Registry
  if [[ -f "$OVERLORD_REGISTRY" ]]; then
    echo -e "  ${RED}✗${NC} Registry: $OVERLORD_REGISTRY"
  else
    echo -e "  ${DIM}○ Registry: $OVERLORD_REGISTRY (not found)${NC}"
  fi
  
  # Registry backups if present
  local backup_count=0
  if [[ -f "$OVERLORD_REGISTRY.bak" ]]; then
    backup_count=$((backup_count + 1))
  fi
  if [[ $backup_count -gt 0 ]]; then
    echo -e "  ${RED}✗${NC} Registry backups: $backup_count file(s)"
  fi
  
  echo ""
}

# List all projects that will be orphaned (in registry)
warn_orphaned_projects() {
  if [[ ! -f "$OVERLORD_REGISTRY" ]]; then
    return 0
  fi
  
  local project_count
  project_count=$(jq -r '.projects | length' "$OVERLORD_REGISTRY" 2>/dev/null || echo "0")
  
  if [[ "$project_count" -eq 0 ]]; then
    return 0
  fi
  
  echo -e "${BOLD}Projects that will become orphaned:${NC}"
  echo -e "${DIM}(Project files remain intact, but registry entries will be lost)${NC}"
  echo ""
  
  # List all projects with formatting
  jq -r '.projects | to_entries[] | 
    "\(.key)\t\(.value.lang)\t\(.value.status)\t\(.value.path)"' \
    "$OVERLORD_REGISTRY" 2>/dev/null | while IFS=$'\t' read -r name lang status path; do
    
    # Format language
    local lang_colored
    case "$lang" in
      python)     lang_colored="${BLUE}Python${NC}" ;;
      typescript) lang_colored="${YELLOW}TypeScript${NC}" ;;
      solidity)   lang_colored="${RED}Solidity${NC}" ;;
      base)       lang_colored="${DIM}Base${NC}" ;;
      *)          lang_colored="$lang" ;;
    esac
    
    # Format status
    local status_colored
    case "$status" in
      active)  status_colored="${GREEN}active${NC}" ;;
      lib)     status_colored="${CYAN}lib${NC}" ;;
      archive) status_colored="${DIM}archive${NC}" ;;
      *)       status_colored="$status" ;;
    esac
    
    echo -e "  • ${BOLD}$name${NC} ($lang_colored) - Status: $status_colored"
    echo -e "    ${DIM}$path${NC}"
  done
  
  echo ""
  echo -e "${YELLOW}!${NC} Total projects: $project_count"
  echo ""
}

# Show confirmation prompt with all details
show_confirmation() {
  local need_sudo="$1"
  
  echo ""
  echo -e "${BOLD}${RED}WARNING: This will remove overlord from your system${NC}"
  echo ""
  
  generate_removal_list
  warn_orphaned_projects
  
  echo -e "${BOLD}What will be preserved:${NC}"
  echo -e "  ${GREEN}✓${NC} All project directories in ~/Work/"
  echo -e "  ${GREEN}✓${NC} Project .tmux.local files"
  echo -e "  ${GREEN}✓${NC} Project Makefile files"
  echo -e "  ${GREEN}✓${NC} Project .opencode/ directories"
  echo -e "  ${GREEN}✓${NC} Project thoughts/ directories"
  echo ""
  
   if [[ "$need_sudo" == true ]]; then
     echo ""
     echo -e "${YELLOW}!${NC} Removing symlink requires administrator access"
     echo "The overlord symlink is located in /usr/local/bin/, which requires"
     echo "administrator (sudo) privileges to modify or delete. You will be prompted"
     echo "for your password when you confirm the uninstall."
     echo ""
   fi
  
  # Prompt for confirmation (default to No)
  local response
  read -r -p "Remove overlord from system? (y/N): " response
  
  case "$response" in
    [yY]|[yY][eE][sS])
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# Create registry backup in /tmp
backup_registry_to_tmp() {
  if [[ ! -f "$OVERLORD_REGISTRY" ]]; then
    log_warning "Registry not found, skipping backup"
    return 0
  fi
  
  local timestamp
  timestamp=$(date +%Y-%m-%d-%H%M%S)
  local backup_path="/tmp/overlord-registry-backup-$timestamp.json"
  
  cp "$OVERLORD_REGISTRY" "$backup_path"
  log_success "Registry backed up to: $backup_path"
  
  # Store backup path for final message
  echo "$backup_path"
}

# Remove symlink from /usr/local/bin
remove_symlink() {
  local need_sudo="$1"
  
  if [[ ! -e "$INSTALL_TARGET" ]]; then
    log_warning "Symlink not found: $INSTALL_TARGET"
    return 0
  fi
  
  log_info "Removing symlink: $INSTALL_TARGET"
  
  if [[ "$need_sudo" == true ]]; then
    if sudo rm "$INSTALL_TARGET"; then
      log_success "Symlink removed (with sudo)"
    else
      log_error "Failed to remove symlink"
      return 1
    fi
  else
    if rm "$INSTALL_TARGET"; then
      log_success "Symlink removed"
    else
      log_error "Failed to remove symlink"
      return 1
    fi
  fi
}

# Remove repository directory
remove_repository() {
  if [[ ! -d "$OVERLORD_REPO" ]]; then
    log_warning "Repository not found: $OVERLORD_REPO"
    return 0
  fi
  
  log_info "Removing repository: $OVERLORD_REPO"
  
  if rm -rf "$OVERLORD_REPO"; then
    log_success "Repository removed"
  else
    log_error "Failed to remove repository"
    return 1
  fi
}

# Main function
main() {
  local dry_run=false
  local force=false
  
  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --dry-run)
        dry_run=true
        shift
        ;;
      --force|-f)
        force=true
        shift
        ;;
      -*)
        log_error "Unknown option: $1"
        echo ""
        usage >&2
        exit 1
        ;;
      *)
        log_error "Unexpected argument: $1"
        echo ""
        usage >&2
        exit 1
        ;;
    esac
  done
  
  # Check sudo requirement
  local need_sudo=false
  if check_sudo_requirement; then
    need_sudo=true
  fi
  
   # Dry-run mode: show what would be deleted
   if [[ "$dry_run" == true ]]; then
     echo ""
     log_info "DRY RUN MODE - No files will be deleted"
     generate_removal_list
     warn_orphaned_projects
     
     if [[ "$need_sudo" == true ]]; then
       echo ""
       echo -e "${YELLOW}!${NC} Removing symlink would require administrator access"
       echo "The overlord symlink is located in /usr/local/bin/, which requires"
       echo "administrator (sudo) privileges to modify or delete. You will be prompted"
       echo "for your password when you confirm the uninstall."
       echo ""
     fi
     
     log_info "Run without --dry-run to actually uninstall"
     exit 0
   fi
  
  # Show confirmation (unless --force)
  if [[ "$force" != true ]]; then
    if ! show_confirmation "$need_sudo"; then
      log_warning "Uninstall cancelled"
      exit 0
    fi
  fi
  
  echo ""
  log_info "Beginning uninstall..."
  echo ""
  
  # Create registry backup
  local backup_path
  backup_path=$(backup_registry_to_tmp)
  
  # Remove symlink (with sudo if needed)
  if ! remove_symlink "$need_sudo"; then
    log_error "Failed to remove symlink, aborting"
    exit 1
  fi
  
  # Remove repository directory
  # Note: This script is running from within the repository that will be deleted.
  # The removal will succeed, but this script will not be able to execute further commands.
  # That's OK - we show the success message before the removal.
  
  echo ""
  log_success "Overlord uninstalled successfully"
  echo ""
  log_info "Summary:"
  echo "  • Symlink removed: $INSTALL_TARGET"
  echo "  • Repository removed: $OVERLORD_REPO"
  if [[ -n "$backup_path" ]]; then
    echo "  • Registry backup: $backup_path"
  fi
  echo ""
  log_info "All project directories and configurations remain intact"
  
  # Remove repository last (this will kill the script)
  remove_repository
}

main "$@"
