#!/usr/bin/env bash
# overlord-rm: Remove project from registry without deleting files
# Registry-only operation - project files remain untouched

set -euo pipefail

OVERLORD_REPO="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
OVERLORD_CONFIG="${OVERLORD_CONFIG:-$OVERLORD_REPO}"
OVERLORD_REGISTRY="$OVERLORD_CONFIG/registry.json"
OVERLORD_BIN="${OVERLORD_BIN:-$OVERLORD_REPO}"

# Source common library
source "$OVERLORD_BIN/lib/common.sh"

# Colors for rm specifically
BOLD='\033[1m'
CYAN='\033[0;36m'
DIM='\033[2m'

usage() {
  cat <<'EOF'
Usage:
  overlord rm <identifier> [options]

Arguments:
  identifier    Project name, alias, or absolute path

Options:
  --force, -f   Skip confirmation prompt
  --help, -h    Show this help

Description:
  Removes project entry from registry without deleting actual files.
  Project directory and all files remain untouched on disk.

Examples:
  overlord rm myproject              # Remove by name (with confirmation)
  overlord rm myalias                # Remove by alias
  overlord rm /path/to/project       # Remove by path
  overlord rm myproject --force      # Skip confirmation

Notes:
  - Creates backup of registry before removal
  - Project files are never deleted
  - Use 'overlord add' to re-register a removed project
EOF
}

# Format status with color
format_status() {
  case "$1" in
    active)  echo -e "${GREEN}$1${NC}" ;;
    lib)     echo -e "${CYAN}$1${NC}" ;;
    archive) echo -e "${DIM}$1${NC}" ;;
    *)       echo "$1" ;;
  esac
}

# Format language with color
format_lang() {
  case "$1" in
    python)     echo -e "${BLUE}$1${NC}" ;;
    typescript) echo -e "${YELLOW}$1${NC}" ;;
    solidity)   echo -e "${RED}$1${NC}" ;;
    *)          echo "$1" ;;
  esac
}

# Find project by name, alias, or path
find_project() {
  local query="$1"
  
  # Try exact name match first
  local result
  result=$(jq -r --arg q "$query" '
    .projects | to_entries[] | 
    select(.key == $q) | 
    [.key, .value.lang, .value.status, .value.path] | @tsv
  ' "$OVERLORD_REGISTRY" 2>/dev/null || true)
  
  if [[ -n "$result" ]]; then
    echo "$result"
    return 0
  fi
  
  # Try alias match second
  result=$(jq -r --arg q "$query" '
    .projects | to_entries[] | 
    select(.value.aliases != null and (.value.aliases[] == $q)) | 
    [.key, .value.lang, .value.status, .value.path] | @tsv
  ' "$OVERLORD_REGISTRY" 2>/dev/null || true)
  
  if [[ -n "$result" ]]; then
    echo "$result"
    return 0
  fi
  
  # Try path match last
  result=$(jq -r --arg q "$query" '
    .projects | to_entries[] | 
    select(.value.path == $q) | 
    [.key, .value.lang, .value.status, .value.path] | @tsv
  ' "$OVERLORD_REGISTRY" 2>/dev/null || true)
  
  if [[ -n "$result" ]]; then
    echo "$result"
    return 0
  fi
  
  return 1
}

# Show confirmation prompt with project details
show_confirmation() {
  local name="$1"
  local lang="$2"
  local status="$3"
  local path="$4"
  
  echo ""
  echo "Removing project from registry:"
  echo ""
  echo -e "  ${BOLD}Name:${NC}     $name"
  echo -e "  ${BOLD}Language:${NC} $(format_lang "$lang")"
  echo -e "  ${BOLD}Status:${NC}   $(format_status "$status")"
  echo -e "  ${BOLD}Path:${NC}     $path"
  echo ""
  
  # Prompt for confirmation (default to No)
  local response
  read -r -p "Remove this project from registry? (y/N): " response
  
  case "$response" in
    [yY]|[yY][eE][sS])
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# Backup registry to .bak file
backup_registry() {
  local backup="$OVERLORD_REGISTRY.bak"
  cp "$OVERLORD_REGISTRY" "$backup"
  log_info "Registry backed up to $backup"
}

# Remove project from registry
remove_from_registry() {
  local name="$1"
  local tmp_file
  tmp_file=$(mktemp)
  
  jq --arg name "$name" 'del(.projects[$name])' \
    "$OVERLORD_REGISTRY" > "$tmp_file"
  
  mv "$tmp_file" "$OVERLORD_REGISTRY"
}

main() {
  # Parse arguments
  local identifier=""
  local force_remove=false
  
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --force|-f)
        force_remove=true
        shift
        ;;
      -*)
        log_error "Unknown option: $1"
        echo ""
        usage >&2
        exit 1
        ;;
      *)
        if [[ -z "$identifier" ]]; then
          identifier="$1"
          shift
        else
          log_error "Too many arguments"
          echo ""
          usage >&2
          exit 1
        fi
        ;;
    esac
  done
  
  # Check if identifier provided
  if [[ -z "$identifier" ]]; then
    log_error "Missing required argument: identifier"
    echo ""
    usage >&2
    exit 1
  fi
  
  # Find project
  local project_info
  if ! project_info=$(find_project "$identifier"); then
    log_error "Project not found: $identifier"
    exit 1
  fi
  
  # Parse project info
  local project_name project_lang project_status project_path
  IFS=$'\t' read -r project_name project_lang project_status project_path <<< "$project_info"
  
  # Show confirmation unless --force
  if [[ "$force_remove" != true ]]; then
    if ! show_confirmation "$project_name" "$project_lang" "$project_status" "$project_path"; then
      log_warning "Removal cancelled"
      exit 0
    fi
  fi
  
  # Backup and remove
  backup_registry
  remove_from_registry "$project_name"
  
  echo ""
  log_success "Project '$project_name' removed from registry"
  log_info "Project files remain at: $project_path"
}

main "$@"
