#!/usr/bin/env bash
# overlord-list: List projects from registry
# Default: shows active projects only

set -euo pipefail

OVERLORD_REPO="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
OVERLORD_CONFIG="${OVERLORD_CONFIG:-$OVERLORD_REPO}"
OVERLORD_REGISTRY="$OVERLORD_CONFIG/registry.json"
OVERLORD_BIN="${OVERLORD_BIN:-$OVERLORD_REPO}"

# Source common library
source "$OVERLORD_BIN/lib/common.sh"

# Colors for list specifically
CYAN='\033[0;36m'
DIM='\033[2m'

usage() {
  cat <<'EOF'
Usage:
  overlord list [options]

Options:
  --py, --python       Filter to Python projects
  --ts, --typescript   Filter to TypeScript projects
  --sol, --solidity    Filter to Solidity projects
  --active             Show active projects (default)
  --lib                Show library projects
  --archive            Show archived projects
  --all                Show all projects regardless of status
  --json               Output as JSON
  --help               Show this help

Language Filtering:
  Multiple language flags can be combined with OR logic:
    --py --ts          Show Python OR TypeScript projects

  Language flags combine with status filters using AND logic:
    --py --all         Show all Python projects (any status)
    --py --archive     Show archived Python projects only

Examples:
  overlord list                  # Active projects (default)
  overlord list --all            # All projects
  overlord list --py --lib       # Python libraries
  overlord list --py --ts        # Python and TypeScript active projects
  overlord list --py --ts --all  # All Python and TypeScript projects
  overlord list --archive        # Archived projects
EOF
}

# Parse arguments
FILTER_LANG=()
FILTER_STATUS="active"
OUTPUT_JSON=false

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --py|--python)
        FILTER_LANG+=("python")
        ;;
      --ts|--typescript)
        FILTER_LANG+=("typescript")
        ;;
      --sol|--solidity)
        FILTER_LANG+=("solidity")
        ;;
      --active)
        FILTER_STATUS="active"
        ;;
      --lib)
        FILTER_STATUS="lib"
        ;;
      --archive)
        FILTER_STATUS="archive"
        ;;
      --all)
        FILTER_STATUS=""
        ;;
      --json)
        OUTPUT_JSON=true
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        echo -e "${RED}Error:${NC} Unknown option: $1" >&2
        exit 1
        ;;
    esac
    shift
  done
}

# Get status color
status_color() {
  case "$1" in
    active)  echo -e "${GREEN}" ;;
    lib)     echo -e "${CYAN}" ;;
    archive) echo -e "${DIM}" ;;
    *)       echo -e "${NC}" ;;
  esac
}

# Get language color
lang_color() {
  case "$1" in
    python)     echo -e "${BLUE}" ;;
    typescript) echo -e "${YELLOW}" ;;
    solidity)   echo -e "${RED}" ;;
    *)          echo -e "${NC}" ;;
  esac
}

# Format language short name
lang_short() {
  case "$1" in
    python)     echo "py" ;;
    typescript) echo "ts" ;;
    solidity)   echo "sol" ;;
    *)          echo "$1" ;;
  esac
}

list_projects() {
  if [[ ! -f "$OVERLORD_REGISTRY" ]]; then
    echo -e "${YELLOW}No registry found.${NC} Run 'overlord new' to create a project."
    exit 0
  fi

  local jq_filter='.projects | to_entries[]'
  
  # Build filter conditions
  local conditions=()
  if [[ -n "$FILTER_STATUS" ]]; then
    conditions+=(".value.status == \"$FILTER_STATUS\"")
  fi
  
  # Build language filter with OR logic for multiple languages
  if [[ ${#FILTER_LANG[@]} -gt 0 ]]; then
    local lang_conditions=()
    for lang in "${FILTER_LANG[@]}"; do
      lang_conditions+=(".value.lang == \"$lang\"")
    done
    # Join with " or " using a loop
    local lang_filter=""
    for i in "${!lang_conditions[@]}"; do
      if [[ $i -eq 0 ]]; then
        lang_filter="${lang_conditions[$i]}"
      else
        lang_filter="$lang_filter or ${lang_conditions[$i]}"
      fi
    done
    conditions+=("($lang_filter)")
  fi

  if [[ ${#conditions[@]} -gt 0 ]]; then
    # Join with " and " using a loop
    local filter_str=""
    for i in "${!conditions[@]}"; do
      if [[ $i -eq 0 ]]; then
        filter_str="${conditions[$i]}"
      else
        filter_str="$filter_str and ${conditions[$i]}"
      fi
    done
    jq_filter="$jq_filter | select($filter_str)"
  fi

  # JSON output
  if [[ "$OUTPUT_JSON" == true ]]; then
    jq "[$jq_filter]" "$OVERLORD_REGISTRY"
    return
  fi

  # Table output
  local projects
  # Sort by status: active (1), lib (2), archive (3)
  projects=$(jq -r "$jq_filter | . + {sort_order: (if .value.status == \"active\" then 1 elif .value.status == \"lib\" then 2 elif .value.status == \"archive\" then 3 else 4 end)} | [.key, .value.lang, .value.status, .value.path, (.value.aliases // [] | join(\",\")), .sort_order] | @tsv" "$OVERLORD_REGISTRY" 2>/dev/null | sort -t$'\t' -k6,6n | cut -f1-5 || true)

  if [[ -z "$projects" ]]; then
    local status_msg=""
    if [[ -n "$FILTER_STATUS" ]]; then
      status_msg=" with status '$FILTER_STATUS'"
    fi
    local lang_msg=""
    if [[ ${#FILTER_LANG[@]} -gt 0 ]]; then
      local lang_list
      lang_list=$(IFS=", "; echo "${FILTER_LANG[*]}")
      lang_msg=" for language(s) '$lang_list'"
    fi
    echo -e "${DIM}No projects found${status_msg}${lang_msg}.${NC}"
    return
  fi

  # Header
  printf "${DIM}%-40s %-6s %-8s %-40s %s${NC}\n" "NAME" "LANG" "STATUS" "PATH" "ALIASES"
  printf "${DIM}%-40s %-6s %-8s %-40s %s${NC}\n" "----" "----" "------" "----" "-------"

  # Projects
  while IFS=$'\t' read -r name lang status path aliases; do
    local lc sc
    lc=$(lang_color "$lang")
    sc=$(status_color "$status")
    local lang_s
    lang_s=$(lang_short "$lang")
    
    # Truncate path for display
    local display_path="$path"
    if [[ ${#display_path} -gt 40 ]]; then
      display_path="...${display_path: -37}"
    fi

    printf "${sc}%-40s ${lc}%-6s ${sc}%-8s ${NC}%-40s ${DIM}%s${NC}\n" \
      "$name" "$lang_s" "$status" "$display_path" "$aliases"
  done <<< "$projects"
}

main() {
  parse_args "$@"
  list_projects
}

main "$@"
